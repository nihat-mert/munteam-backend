generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  PERSONNEL
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum KurumTipi {
  BIREYSEL
  KURUMSAL
}

enum RequestType {
  FIYAT_TEKLIFI
  ANALIZ_BASVURUSU
}

enum RequestStatus {
  TASLAK
  ONAY_BEKLIYOR
  ONAYLANDI
  BEKLIYOR
  ISLEMDE
  TAMAMLANDI
  REDDEDILDI
}

enum AmbalajSekli {
  CAM
  PLASTIK
  KARTON
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  password       String
  role           Role       @default(CUSTOMER)
  isActive       Boolean    @default(true)
  adSoyad        String?
  unvan          String?
  telefon        String?
  kurumTipi      KurumTipi  @default(BIREYSEL)
  tcKimlik       String?    @unique
  vergiNo        String?    @unique
  faturaAdresi   String?    @db.Text
  iletisimAdresi String?    @db.Text
  orders         Order[]
  analysisRequests AnalysisRequest[]
  appointments   Appointment[]
  budgetProjects BudgetProject[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Product {
  id           String      @id @default(uuid())
  name         String
  atomicNumber Int
  description  String      @db.Text
  price        Decimal     @db.Decimal(10, 2)
  stock        Int
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([name])
  @@index([atomicNumber])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
}

model Report {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
}

model AnalysisCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  analysisTypes AnalysisType[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AnalysisType {
  id          String           @id @default(uuid())
  categoryId  String
  category    AnalysisCategory @relation(fields: [categoryId], references: [id])
  name        String
  price       Decimal          @db.Decimal(10, 2)
  sampleAnalyses SampleAnalysis[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

model AnalysisRequest {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  requestType       RequestType
  status            RequestStatus @default(TASLAK)
  odemeKaynaki      String?
  kullanimAmaci     String?        @db.Text
  projeNo           String?
  destekAlanKurulus String?
  teslimYontemi     String?
  toplamTutar       Decimal?      @db.Decimal(10, 2)
  ekDosyaUrl        String?
  sonucUrl          String?
  paymentStatus     String         @default("BEKLIYOR")
  samples           Sample[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Sample {
  id               String           @id @default(uuid())
  requestId        String
  request          AnalysisRequest @relation(fields: [requestId], references: [id])
  numuneAdi        String
  ambalajSekli     AmbalajSekli
  kartonBoyutu     String?
  numuneHazirlik   String?
  baskaSoru       String?
  iadeEdilecekMi   Boolean          @default(false)
  tehlikeliMi      Boolean          @default(false)
  sampleAnalyses   SampleAnalysis[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([requestId])
}

model SampleAnalysis {
  id             String        @id @default(uuid())
  sampleId       String
  sample         Sample        @relation(fields: [sampleId], references: [id])
  analysisTypeId String
  analysisType   AnalysisType  @relation(fields: [analysisTypeId], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([sampleId, analysisTypeId])
  @@index([sampleId])
  @@index([analysisTypeId])
}

model Appointment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  cihazAdi       String
  baslangicTarihi DateTime
  bitisTarihi    DateTime
  status         String   @default("BEKLIYOR")
  aciklama       String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([cihazAdi, baslangicTarihi])
}

model BudgetProject {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  name        String
  limitAmount Decimal    @db.Decimal(12, 2)
  spentAmount Decimal    @db.Decimal(12, 2) @default(0)
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model Payment {
  id             String   @id @default(uuid())
  projectId      String
  project        BudgetProject @relation(fields: [projectId], references: [id])
  dekontNo       String
  amount         Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model Survey {
  id        String   @id @default(uuid())
  userId    String
  requestId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([requestId])
}
